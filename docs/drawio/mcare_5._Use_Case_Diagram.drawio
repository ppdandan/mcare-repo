<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram id="1" name="5. Use Case Diagram">

    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" toolTip="1" earlierVersionEnabled="1" undoLimit="100" directed="1">
      <root>
<mxCell id="e0" value="" vertex="false" edge="false"/>
<mxCell id="cell_1" value="Patient
    actor "Staff / Receptionist" as Staff
    actor "Doctor / Sonologist" as Doctor
    actor Admin

    package "M-Care Patient Mobile App" {
        UC1[Register / Login]
        UC2[Book Appointment]
        UC3[View Upcoming Appointments]
        UC4[Cancel Appointment]
        UC5[View Medical Records]
        UC6[View Transaction History]
        UC7[Update Profile &\nEmergency Info]
        UC8[Receive Push Notifications]
        UC9[Send Inquiry to Clinic]
    }

    package "M-Care Staff Web Dashboard" {
        UC10[Login / Auth]
        UC11[Manage Patients\n(Search, Register Walk-in)]
        UC12[Approve / Decline Appointments]
        UC13[Reschedule / Cancel Appointments]
        UC14[Calendar Views\n(Day/Week/Month)]
        UC15[View / Edit Medical Records\n(Role-separated fields)]
        UC16[Record Payment Transaction]
        UC17[Void Transaction with Reason]
        UC18[Manage Doctor Schedules]
        UC19[Manage Inventory Items]
        UC20[View Analytics Charts]
        UC21[Export Reports CSV]
    }

    Patient --> UC1
    Patient --> UC2
    Patient --> UC3
    Patient --> UC4
    Patient --> UC5
    Patient --> UC6
    Patient --> UC7
    Patient --> UC8
    Patient --> UC9

    Staff --> UC10
    Staff --> UC11
    Staff --> UC12
    Staff --> UC13
    Staff --> UC14
    Staff --> UC15
    Staff --> UC16
    Staff --> UC17
    Staff --> UC18
    Staff --> UC19
    Staff --> UC20
    Staff --> UC21

    Doctor --> UC10
    Doctor --> UC14
    Doctor --> UC15

    Admin --> UC10
    Admin --> UC11
    Admin --> UC12
    Admin --> UC13
    Admin --> UC14
    Admin --> UC15
    Admin --> UC16
    Admin --> UC17
    Admin --> UC18
    Admin --> UC19
    Admin --> UC20
    Admin --> UC21

    UC2 ..> UC1 : <<include>>
    UC3 ..> UC1 : <<include>>
    UC4 ..> UC1 : <<include>>
    UC5 ..> UC1 : <<include>>
    UC6 ..> UC1 : <<include>>
    UC7 ..> UC1 : <<include>>
    UC9 ..> UC1 : <<include>>

    UC12 ..> UC10 : <<include>>
    UC13 ..> UC10 : <<include>>
    UC14 ..> UC10 : <<include>>
    UC15 ..> UC10 : <<include>>
    UC16 ..> UC10 : <<include>>
    UC17 ..> UC10 : <<include>>
    UC18 ..> UC10 : <<include>>
    UC19 ..> UC10 : <<include>>
    UC20 ..> UC10 : <<include>>
    UC21 ..> UC10 : <<include>>

    UC15 ..> UC12 : <<extend>>\n(doctor writes diagnosis/Rx)
    UC15 ..> UC13 : <<extend>>\n(nurse writes vitals)" style="shape=ellipse;" vertex="true" geometry="40;40;100;50;"/>
