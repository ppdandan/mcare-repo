<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram id="1" name="1. Flowchart — Patient Appointment Booking Flow">

    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" toolTip="1" earlierVersionEnabled="1" undoLimit="100" directed="1">
      <root>
<mxCell id="e0" value="" vertex="false" edge="false"/>
<mxCell id="cell_1" value="Patient Opens Mobile App" style="shape=ellipse;" vertex="true" geometry="40;40;100;50;"/>
<mxCell id="cell_2" value="Select Service" style="shape=ellipse;" vertex="true" geometry="160;40;100;50;"/>
<mxCell id="cell_3" value="Select Date\n(Weekdays Only, Asia/Manila)" style="shape=ellipse;" vertex="true" geometry="280;40;100;50;"/>
<mxCell id="cell_4" value="Select Available Slot\nvia get_available_slots RPC" style="shape=ellipse;" vertex="true" geometry="400;40;100;50;"/>
<mxCell id="cell_5" value="Review Details" style="shape=ellipse;" vertex="true" geometry="520;40;100;50;"/>
<mxCell id="cell_6" value="Confirm Booking" style="shape=diamond;" vertex="true" geometry="640;40;100;50;"/>
<mxCell id="cell_7" value="Reject: Weekends not allowed" style="shape=ellipse;" vertex="true" geometry="40;110;100;50;"/>
<mxCell id="cell_8" value="Reject: Slot already taken\nGiST constraint" style="shape=ellipse;" vertex="true" geometry="160;110;100;50;"/>
<mxCell id="cell_9" value="Create appointment\nstatus = 'pending'" style="shape=ellipse;" vertex="true" geometry="280;110;100;50;"/>
<mxCell id="cell_10" value="Realtime: Push to Staff Dashboard" style="shape=ellipse;" vertex="true" geometry="400;110;100;50;"/>
<mxCell id="cell_11" value="Staff: Approve / Decline / Reschedule" style="shape=ellipse;" vertex="true" geometry="520;110;100;50;"/>
<mxCell id="cell_12" value="status = 'approved'" style="shape=ellipse;" vertex="true" geometry="640;110;100;50;"/>
<mxCell id="cell_13" value="status = 'cancelled'" style="shape=ellipse;" vertex="true" geometry="40;180;100;50;"/>
<mxCell id="cell_14" value="status = 'rescheduled'\nnew start_time" style="shape=ellipse;" vertex="true" geometry="160;180;100;50;"/>
<mxCell id="cell_15" value="Realtime: Push to Patient App" style="shape=ellipse;" vertex="true" geometry="280;180;100;50;"/>
<mxCell id="cell_16" value="Patient sees updated status" style="shape=ellipse;" vertex="true" geometry="400;180;100;50;"/>
<mxCell id="cell_17" value="Visit Day: Staff marks completed" style="shape=ellipse;" vertex="true" geometry="520;180;100;50;"/>
<mxCell id="cell_18" value="status = 'completed'" style="shape=ellipse;" vertex="true" geometry="640;180;100;50;"/>
<mxCell id="cell_19" value="Staff may record transaction\nfor completed visit" style="shape=ellipse;" vertex="true" geometry="40;250;100;50;"/>
